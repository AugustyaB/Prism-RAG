# ═══ Prism-RAG Configuration (.env.example) ═══
# Copy this file to .env and adjust values for your environment.

# --- LLM Provider Selection ---
# Options: "lmstudio" (default), "ollama", or "gemini"
RAG_LLM_PROVIDER=lmstudio

# --- LM Studio (OpenAI-compatible local inference) ---
RAG_LMSTUDIO_BASE_URL=http://localhost:1234/v1
RAG_LMSTUDIO_MODEL=qwen2.5-7b-instruct

# --- Ollama (Local LLM service) ---
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OLLAMA_MODEL=llama3.1:8b

# --- Google Gemini (Cloud LLM Fallback) ---
# Get your free API key at: https://aistudio.google.com
RAG_GEMINI_API_KEY=your_gemini_api_key_here
RAG_GEMINI_MODEL=gemini-2.5-flash

# --- Embedding & Reranker Hardware ---
RAG_EMBEDDING_DEVICE=cuda
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_MIN_RERANK_SCORE=0.08

# --- GPU OCR Configuration ---
RAG_OCR_GPU=true
RAG_OCR_DPI=200
RAG_OCR_TIMEOUT_SECONDS=30

# --- Ingestion Queue & Watcher ---
RAG_MAX_INGESTION_WORKERS=1
RAG_AUTO_INGEST_INTERVAL_SECONDS=5

# --- Security & Multi-Tenant RBAC ---
RAG_JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
RAG_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
RAG_AUTH_ENABLED=true

# --- Storage Mode ('local' or 'cloud') ---
RAG_STORAGE_MODE=local
# RAG_CLOUD_QDRANT_URL=https://xxxx.cloud.qdrant.io:6333
# RAG_CLOUD_QDRANT_API_KEY=your_qdrant_cloud_api_key
# RAG_CLOUD_DATABASE_URL=postgresql://user:password@host:5432/dbname
